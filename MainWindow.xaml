<Window x:Class="GraphEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Graph Editor" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Меню -->
        <Menu Grid.Row="0" Background="LightGray">
            <MenuItem Header="_File">
                <MenuItem x:Name="MenuItemFileOpen" 
                          Header="_Open" 
                          InputGestureText="Ctrl+O"/>
                <MenuItem x:Name="MenuItemFileSave" 
                          Header="_Save" 
                          InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem x:Name="MenuItemFileExit" 
                          Header="E_xit" 
                          InputGestureText="Alt+F4"/>
            </MenuItem>
            
            <MenuItem Header="_Help">
                <MenuItem x:Name="MenuItemHelpAbout" 
                          Header="_About"/>
            </MenuItem>
        </Menu>
        
        <!-- Основная область с Canvas -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="GraphCanvas" 
                    Background="White"
                    Focusable="True">
                <Canvas.InputBindings>
                    <KeyBinding Gesture="Ctrl+O"/>
                    <KeyBinding Gesture="Ctrl+S"/>
                </Canvas.InputBindings>
            </Canvas>
        </ScrollViewer>
    </Grid>
</Window>
