<Window x:Class="GraphEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Graph Editor" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="#F0F0F0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Меню -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Open..." Name="MenuItemFileOpen"/>
                <MenuItem Header="Save" Name="MenuItemFileSave"/>
                <Separator/>
                <MenuItem Header="Exit" Name="MenuItemFileExit"/>
            </MenuItem>

            <MenuItem Header="Edit">
                <MenuItem Header="Select All" Name="MenuItemEditSelectAll"/>
                <MenuItem Header="Clear Selection" Name="MenuItemEditClearSelection"/>
            </MenuItem>

            <MenuItem Header="View">
                <MenuItem Header="Reset Colors" Name="MenuItemViewResetColors"/>
            </MenuItem>

            <MenuItem Header="Layout">
                <MenuItem Header="Circle Layout" Name="MenuItemLayoutCircle"/>
                <MenuItem Header="Random Layout" Name="MenuItemLayoutRandom"/>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="About" Name="MenuItemHelpAbout"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов -->
        <ToolBarTray DockPanel.Dock="Top" Background="#E0E0E0">
            <ToolBar>
                <!-- Режимы работы -->
                <Button Name="BtnSelectMode" ToolTip="Select Mode" Content="Select"/>
                <Button Name="BtnDragMode" ToolTip="Drag Mode" Content="Drag"/>

                <Separator/>

                <!-- Добавление элементов -->
                <Button Name="BtnAddVertex" ToolTip="Add Vertex" Content="Add Vertex"/>
                <Button Name="BtnAddEdge" ToolTip="Add Edge" Content="Add Edge"/>

                <Separator/>

                <!-- Layout алгоритмы -->
                <Button Name="BtnCircleLayout" ToolTip="Circle Layout" Content="Circle"/>
                <Button Name="BtnRandomLayout" ToolTip="Random Layout" Content="Random"/>

                <Separator/>

                <!-- Действия -->
                <Button Name="BtnResetColors" ToolTip="Reset Colors" Content="Reset Colors"/>
                <Button Name="BtnDelete" ToolTip="Delete Selected" Content="Delete"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Основная область -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Canvas для отрисовки графа -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="5" Background="White">
                <Canvas Name="GraphCanvas" 
                        Background="White"
                        Focusable="True"
                        FocusVisualStyle="{x:Null}">
                    <!-- Граф будет отрисован здесь -->
                </Canvas>
            </Border>

            <!-- Строка состояния -->
            <StatusBar Grid.Row="1" Background="#F0F0F0">
                <StatusBarItem>
                    <TextBlock Name="StatusText" Text="Ready" Margin="5,0"/>
                </StatusBarItem>

                <Separator/>

                <StatusBarItem>
                    <TextBlock Name="VertexCountText" Text="Vertices: 0" Margin="5,0"/>
                </StatusBarItem>

                <StatusBarItem>
                    <TextBlock Name="EdgeCountText" Text="Edges: 0" Margin="5,0"/>
                </StatusBarItem>

                <Separator/>

                <StatusBarItem>
                    <TextBlock Name="LayoutStatusText" Text="Layout: None" Margin="5,0"/>
                </StatusBarItem>

                <Separator/>

                <StatusBarItem>
                    <TextBlock Name="ModeText" Text="Mode: Select" Margin="5,0"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>