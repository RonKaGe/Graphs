<Window x:Class="GraphEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Graph Editor" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="12*"/>
            <ColumnDefinition Width="113*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. МЕНЮ -->
        <Menu Grid.Row="0" Background="#FFE0E0E0" Grid.ColumnSpan="2" Margin="0,0,0,18">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" 
                          Command="{Binding OpenCommand}" 
                          InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save" 
                          Command="{Binding SaveCommand}" 
                          InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="E_xit" 
                          Command="{Binding ExitCommand}" 
                          InputGestureText="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="Add _Vertex" 
                          Command="{Binding AddVertexCommand}"/>
                <MenuItem Header="Add _Edge" 
                          Command="{Binding AddEdgeCommand}"/>
                <Separator/>
                <MenuItem Header="_Delete" 
                          Command="{Binding DeleteCommand}" 
                          InputGestureText="Delete"/>
            </MenuItem>

            <MenuItem Header="_Layout">
                <MenuItem Header="Circle Layout" 
                          Command="{Binding CircleLayoutCommand}"/>
                <MenuItem Header="Random Layout" 
                          Command="{Binding RandomLayoutCommand}"/>
                <MenuItem Header="Force Layout" 
                          Command="{Binding ForceLayoutCommand}"/>
                <Separator/>
                <MenuItem Header="Reset Colors" 
                          Command="{Binding ResetColorsCommand}"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About" 
                          Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- 2. ПАНЕЛЬ ИНСТРУМЕНТОВ -->
        <ToolBar Background="#FFE8E8E8" Grid.ColumnSpan="2" Margin="0,18,0,18" Grid.RowSpan="2">
            <Button Content="📂 Open" 
                    Command="{Binding OpenCommand}" 
                    Margin="2" 
                    Padding="10,5"
                    ToolTip="Open graph file"/>
            <Button Content="💾 Save" 
                    Command="{Binding SaveCommand}" 
                    Margin="2" 
                    Padding="10,5"
                    ToolTip="Save graph file"/>

            <Separator/>

            <Button Content="➕ Vertex" 
                    Command="{Binding AddVertexCommand}" 
                    Margin="2" 
                    Padding="10,5"
                    ToolTip="Add new vertex"/>
            <Button Content="🔗 Edge" 
                    Command="{Binding AddEdgeCommand}" 
                    Margin="2" 
                    Padding="10,5"
                    ToolTip="Add new edge"/>
            <Button Content="❌ Delete" 
                    Command="{Binding DeleteCommand}" 
                    Margin="2" 
                    Padding="10,5"
                    ToolTip="Delete selected"/>

            <Separator/>

            <Button Content="⭕ Circle" 
                    Command="{Binding CircleLayoutCommand}" 
                    Margin="2" 
                    Padding="10,5"
                    ToolTip="Apply circle layout"/>
            <Button Content="🎲 Random" 
                    Command="{Binding RandomLayoutCommand}" 
                    Margin="2" 
                    Padding="10,5"
                    ToolTip="Apply random layout"/>
            <Button Content="🌀 Force" 
                    Command="{Binding ForceLayoutCommand}" 
                    Margin="2" 
                    Padding="10,5"
                    ToolTip="Apply force layout"/>
            <Button Content="🎨 Reset" 
                    Command="{Binding ResetColorsCommand}" 
                    Margin="2" 
                    Padding="10,5"
                    ToolTip="Reset colors"/>
        </ToolBar>

        <!-- 3. ОСНОВНАЯ ОБЛАСТЬ -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      Background="White" Grid.ColumnSpan="2" Margin="0,19,0,0" Grid.RowSpan="2">
            <Canvas x:Name="GraphCanvas" 
                    Focusable="True">

                <!-- Сетка на фоне - УБРАЛ Background="White" отсюда -->
                <Canvas.Background>
                    <DrawingBrush Viewport="0,0,20,20" 
                                 ViewportUnits="Absolute" 
                                 TileMode="Tile">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,20,20"/>
                                </GeometryDrawing.Geometry>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#FFEEEEEE" Thickness="0.5"/>
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>

                <!-- Горячие клавиши -->
                <Canvas.InputBindings>
                    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"/>
                    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                </Canvas.InputBindings>

                <!-- Элементы графа будут добавляться здесь -->

            </Canvas>
        </ScrollViewer>

        <!-- 4. СТАТУС БАР -->
        <StatusBar Grid.Row="2" Background="#FFE0E0E0" Grid.ColumnSpan="2" Margin="0,589,0,0" Grid.RowSpan="2">
            <!-- Статус -->
            <StatusBarItem HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status:" FontWeight="Bold" Margin="5,0,2,0"/>
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="DarkBlue"
                               VerticalAlignment="Center"
                               Width="300"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Разделитель -->
            <Separator/>

            <!-- Алгоритм -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Layout:" FontWeight="Bold" Margin="5,0,2,0"/>
                    <TextBlock Text="{Binding LayoutStatus}" 
                               Foreground="DarkGreen"
                               VerticalAlignment="Center"
                               Width="150"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Разделитель -->
            <Separator/>

            <!-- Счетчики -->
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <TextBlock Text="Vertices:" FontWeight="Bold" Margin="0,0,2,0"/>
                    <TextBlock Text="{Binding VertexCount}" 
                               Foreground="Blue" 
                               FontWeight="Bold"
                               Width="30"
                               TextAlignment="Right"/>

                    <TextBlock Text="  Edges:" FontWeight="Bold" Margin="10,0,2,0"/>
                    <TextBlock Text="{Binding EdgeCount}" 
                               Foreground="Red" 
                               FontWeight="Bold"
                               Width="30"
                               TextAlignment="Right"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>