<!-- MainWindow.xaml -->
<Window x:Class="GraphEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        
        Title="Graph Editor" 
        Height="600" 
        Width="800"
        
        <!-- Это свойство пригодится позже для привязки команд через ViewModel -->
        WindowStartupLocation="CenterScreen">
    
    <!-- Основной контейнер окна - Grid -->
    <Grid>
        
        <!-- Определение строк Grid'а: 
             1. Auto - для меню (занимает столько места, сколько нужно)
             2. * (звездочка) - для Canvas (занимает всё оставшееся пространство) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- =============================== -->
        <!-- 1. МЕНЮ (Menu) - размещается в первой строке Grid'а -->
        <!-- =============================== -->
        <Menu Grid.Row="0" Background="LightGray">
            
            <!-- Пункт меню "File" (Файл) -->
            <MenuItem Header="_File"> <!-- Подчеркивание перед F делает Alt+F горячей клавишей -->
                
                <!-- Подпункт "Open" (Открыть) -->
                <MenuItem x:Name="MenuItemFileOpen" 
                          Header="_Open" 
                          InputGestureText="Ctrl+O"/>
                <!-- InputGestureText подсказывает пользователю горячую клавишу -->
                
                <!-- Подпункт "Save" (Сохранить) -->
                <MenuItem x:Name="MenuItemFileSave" 
                          Header="_Save" 
                          InputGestureText="Ctrl+S"/>
                
                <!-- Разделитель между группами пунктов -->
                <Separator/>
                
                <!-- Подпункт "Exit" (Выход) -->
                <MenuItem x:Name="MenuItemFileExit" 
                          Header="E_xit" 
                          InputGestureText="Alt+F4"/>
            </MenuItem>
            
            <!-- Пункт меню "Help" (Справка) -->
            <MenuItem Header="_Help">
                <!-- Подпункт "About" (О программе) -->
                <MenuItem x:Name="MenuItemHelpAbout" 
                          Header="_About"/>
            </MenuItem>
            
        </Menu>
        
        <!-- =============================== -->
        <!-- 2. ОСНОВНАЯ ОБЛАСТЬ - CANVAS для рисования графа -->
        <!-- Размещается во второй строке Grid'а -->
        <!-- ScrollViewer позволит прокручивать граф, если он не помещается -->
        <!-- =============================== -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto">
            
            <!-- 
                GraphCanvas - это "холст", на котором будут рисоваться:
                - Вершины (кружки/прямоугольники)
                - Рёбра (линии/стрелки)
                Позже к нему будет привязана ViewModel и отрисовка через Shapes или DrawingVisual.
                KeyBinding задаёт горячие клавиши для всего окна.
            -->
            <Canvas x:Name="GraphCanvas" 
                    Background="White"
                    Focusable="True">
                
                <!-- Глобальные горячие клавиши для окна -->
                <Canvas.InputBindings>
                    <KeyBinding Gesture="Ctrl+O" 
                                Command="{Binding OpenCommand}"/> <!-- Позже заменим на реальную команду -->
                    <KeyBinding Gesture="Ctrl+S" 
                                Command="{Binding SaveCommand}"/>
                </Canvas.InputBindings>
                
                <!-- 
                    В будущем здесь будут динамически добавляться элементы:
                    <Ellipse ... /> для вершин
                    <Line ... /> для рёбер
                    Или будет использоваться более сложная отрисовка (через DrawingVisual).
                -->
                
            </Canvas>
            
        </ScrollViewer>
        
    </Grid>
</Window>
